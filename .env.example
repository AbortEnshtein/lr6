# Скопируйте в .env:  cp .env.example .env
# В Docker файл .env читает docker compose.
# На Vercel те же переменные задаются в Settings → Environment Variables.

# ---------- Вход в редактор (/admin) ----------
ADMIN_USERNAME=admin
# Хеш пароля (scrypt), сам пароль нигде не хранится. Получить: make hash
ADMIN_PASSWORD_HASH=
# Секрет для подписи cookie сессии, ≥ 32 символов. Получить: make secret
SESSION_SECRET=

# ---------- Уведомления о заявках в Telegram ----------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш user id (подскажет @userinfobot). Перед этим отправьте своему боту /start,
# иначе бот не сможет вам написать.
TELEGRAM_CHAT_ID=

# ---------- База данных (Upstash Redis REST API) ----------
# В Docker заполнять НЕ нужно: compose подключит локальный Redis сам.
# На Vercel переменные появятся сами после подключения Upstash (Storage → Upstash for Redis).
KV_REST_API_URL=
KV_REST_API_TOKEN=
